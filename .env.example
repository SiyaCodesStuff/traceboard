# Supabase project URL from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon or publishable client key from Project Settings > API.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase pooled Postgres connection string from Project Settings > Database, using port 6543.
DATABASE_URL=

# Supabase direct Postgres connection string from Project Settings > Database, using port 5432.
DIRECT_URL=
